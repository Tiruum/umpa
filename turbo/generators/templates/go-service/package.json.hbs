{
  "name": "@umpa/{{name}}-api",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "gen:go": "go run github.com/oapi-codegen/oapi-codegen/v2/cmd/oapi-codegen@v2.5.0 -config api/oapi.codegen.yaml api/openapi.yaml && go mod tidy",
    "gen:sdk": "pnpm dlx openapi-typescript-codegen --input ./api/openapi.yaml --output ../../packages/{{name}}-sdk/src/generated --client fetch --useOptions",
    "gen": "pnpm run gen:go && pnpm run gen:sdk",
    "dev": "pnpm run gen:go && go run ./cmd/{{name}}-api",
    "build": "pnpm run gen:go && mkdir -p dist && go build -trimpath -ldflags '-s -w' -o dist/{{name}}-api ./cmd/{{name}}-api",
    "test": "pnpm run gen:go && go test ./...",
    "typecheck": "pnpm run gen:go && go test ./...",
    "lint": "pnpm run gen:go && go vet ./...",
    "format": "gofmt -w .",
    "check": "pnpm run lint && pnpm run test && pnpm run build"
  }
}
